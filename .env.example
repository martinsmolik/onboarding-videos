# --- Sloneek demo tenant (recorder + explorer) ---
SLONEEK_DEMO_URL=https://app.sloneek.com
SLONEEK_DEMO_USER=
SLONEEK_DEMO_PASS=

# --- ffmpeg (optional) ---
# Default: Homebrew ffmpeg-full keg (/opt/homebrew/opt/ffmpeg-full/bin) if installed, else ffmpeg/ffprobe on PATH.
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- LLM (explorer, scenarist) ---
ANTHROPIC_API_KEY=

# --- Knowledge ---
LINEAR_API_KEY=
OPENAI_API_KEY=            # only if using Whisper API for transcription

# --- YouTube upload (orchestrator) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=unlisted
