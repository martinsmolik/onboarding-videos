{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sloneek-video/scenario",
  "title": "Scenario",
  "description": "Human/LLM-level plan of a video: narration + intent per step, no selectors. Produced by scenarist, consumed by explorer which turns it into a recipe.",
  "type": "object",
  "required": ["id", "lang", "title", "audience", "steps"],
  "properties": {
    "id": { "type": "string" },
    "lang": { "type": "string", "enum": ["cs", "en", "sk"] },
    "title": { "type": "string" },
    "audience": { "type": "string", "enum": ["admin", "manager", "employee"] },
    "source": {
      "type": "object",
      "description": "provenance – what this scenario was derived from",
      "properties": {
        "old_video_url": { "type": "string" },
        "old_transcript_path": { "type": "string" },
        "release_notes_since": { "type": "string", "format": "date" },
        "changes_detected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "narration", "intent"],
        "properties": {
          "id": { "type": "string" },
          "narration": { "type": "string" },
          "intent": { "type": "string", "description": "What the user should see happen, in plain words: 'open Attendance > Overview from the left menu'" },
          "must_show": { "type": "string", "description": "What must be visible at the end of the step (explorer turns it into expect)" }
        }
      }
    }
  }
}
