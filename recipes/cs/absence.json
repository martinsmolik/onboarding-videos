      "actions": [
        {
          "type": "wait",
          "value": "1500"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainNavigationDiv] a[href=\"/app/my-profile/absence-overview\"]",
        "url_contains": "/app/dashboard"
      },
      "hold_after_ms": 500
    },
    {
      "id": "s02",
      "narration": "V Sloneeku máte dovolené, nemocenské i sick days na jednom místě. Zaměstnanci o volno žádají sami, manažer žádost schválí a vy máte data rovnou připravená pro mzdy.",
      "narration_tts": "V Sloníku máte dovolené, nemocenské i sik dejs na jednom místě. Zaměstnanci o volno žádají sami, manažer žádost schválí a vy máte data rovnou připravená pro mzdy.",
      "actions": [
        {
          "type": "hover",
          "selector": "[data-cy=mainNavigationDiv] a[href=\"/app/my-profile/absence-overview\"]",
          "before_ms": 1500
        },
        {
          "type": "highlight",
