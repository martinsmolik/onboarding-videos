      "narration": "Nejdřív si modul připravíme. Jedna podmínka předem: zaměstnanec musí mít přiřazenou pracovní dobu. Bez ní systém nezná jeho pracovní fond a absenci mu nespočítá. Návod najdete ve videu Pracovní doba.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a[href=\"/app/settings/dashboard\"]",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "2000"
        },
        {
