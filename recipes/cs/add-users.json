      "expect": {
        "visible": "[data-cy=emailInput]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s10",
      "narration": "Volba Skrýt e-mail pro ostatní kolegy schová adresu v sekci Kolegové. Hodí se třeba u soukromého e-mailu.",
