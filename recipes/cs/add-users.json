        {
          "type": "type",
          "selector": "[data-cy=firstNameInput]",
          "value": "Jana",
          "clear": true,
          "before_ms": 600
        },
        {
          "type": "type",
          "selector": "[data-cy=surnameInput]",
          "value": "Dvořáková",
          "clear": true,
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=surnameInput]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s09",
      "narration": "Zadám její pracovní e-mail. Na tuto adresu jí po aktivaci přijde pozvánka do Sloneeku.",
