        {
          "type": "wait",
          "value": "2000"
        },
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-ombudsman]",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "1800"
        },
        {
          "type": "press",
          "value": "Escape",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "500"
        }
