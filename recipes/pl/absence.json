    {
      "id": "s12",
      "narration": "Komu typ przysługuje i w jakim wymiarze, ustalacie w Masowych ustawieniach nieobecności. Każda osoba ma tu wiersz dla każdego typu nieobecności. W pierwszej kolumnie udostępniacie nieobecność, a w kolumnie Wymaga zatwierdzenia decydujecie, czy musi ją zatwierdzić przełożony.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a[href=\"/app/settings/absence/collective-claims\"]"
        },
        {
          "type": "wait",
          "value": "3500"
        },
        {
          "type": "type",
          "selector": "input[aria-label=\"Imię Filter Input\"]",
          "value": "Claver",
          "speed": "fast"
        },
        {
          "type": "wait",
          "value": "2500"
        },
        {
          "type": "highlight",
          "selector": ".ag-header-cell[col-id=allowed]"
        },
        {
          "type": "highlight",
