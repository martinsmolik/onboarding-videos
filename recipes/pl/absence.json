      "id": "s19",
      "narration": "W notatce wpisuję, kto mnie zastąpi, żeby koledzy wiedzieli. Klikam Utwórz.",
      "actions": [
        {
          "type": "fill",
          "selector": "nb-dialog-container [data-cy=noteTextarea]",
          "value": "Zastępuje mnie Piotr."
        },
        {
          "type": "wait",
          "value": "400"
        },
        {
          "type": "click",
          "selector": "nb-dialog-container [data-cy=submitButton]:text-is(\"Utwórz\")",
