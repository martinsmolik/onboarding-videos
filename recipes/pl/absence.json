    {
      "id": "s20",
      "narration": "Nieobecność jest wśród nadchodzących. Jako administratorka mam zatwierdzenie automatycznie. Wniosek Eli trafiłby do przełożonego i do zatwierdzenia świeciłby na pomarańczowo. Po zatwierdzeniu zmieni kolor na zielony i dopiero wtedy odejmie się od salda.",
      "actions": [
        {
          "type": "highlight",
          "selector": ".upcoming-container span:text-is(\"23.11.2026 - 25.11.2026\")"
        },
        {
          "type": "highlight",
          "selector": "h6:text-is(\"Nadchodzące nieobecności\")"
        }
      ]
    },
