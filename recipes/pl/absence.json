        {
          "type": "wait",
          "value": "600"
        },
        {
          "type": "zoom",
          "selector": "input[data-cy=yearlyEntitlementInput]",
          "value": "1.6",
          "hold_ms": 1800
        }
      ],
      "expect": {
        "visible": "nb-checkbox[data-cy=healthReasonsCheckbox]"
      }
    },
    {
      "id": "s09",
      "narration": "Powody zdrowotne zostawiam wyłączone. Zaznaczacie je przy zwolnieniu lekarskim albo opiece nad członkiem rodziny, które liczą się w dniach kalendarzowych. W ograniczeniu czasowym ustawiam siedem, więc urlop trzeba zgłosić co najmniej tydzień wcześniej.",
      "actions": [
        {
          "type": "zoom",
          "selector": "nb-checkbox[data-cy=healthReasonsCheckbox]",
          "value": "1.8",
          "hold_ms": 2500
        },
        {
          "type": "click",
          "selector": "nb-checkbox[data-cy=eventTimeoutCheckbox] .custom-checkbox",
          "before_ms": 1500
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "fill",
          "selector": "input[data-cy=eventTimeoutInput]",
          "value": "7"
        },
        {
          "type": "wait",
          "value": "500"
        },
        {
          "type": "highlight",
          "selector": "nb-checkbox[data-cy=eventTimeoutCheckbox]"
        }
      ],
      "expect": {
        "visible": "input[data-cy=eventTimeoutInput]"
