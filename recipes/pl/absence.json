      "actions": [
        {
          "type": "click",
          "selector": "button[data-cy=addAbsenceButton]:text-is(\"Zgłoś nieobecność\")",
          "before_ms": 1500
        },
        {
          "type": "wait",
          "value": "1200"
        },
        {
          "type": "click",
          "selector": "nb-dialog-container nb-toggle[data-cy=differentUserToggle]",
