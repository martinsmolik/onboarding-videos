{
  "id": "add-users",
  "version": 2,
  "title": "Dodaj użytkowników do systemu: ręczne zakładanie, zaproszenie i import",
  "lang": "pl",
  "app_version": "preprod-2026-10-11",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "start": {
    "url": "https://app-pre-production.sloneek.com/app/dashboard-v2",
    "local_storage": {
      "local-translate": "pl"
    }
  },
  "voice": {
    "provider": "external",
    "voice_id": "F9eb9uZYeJuHuO7Uvs1R",
    "model_id": "eleven_v4"
  },
  "chapters": true,
  "interstitials": true,
  "thumbnail": {
    "shot": "s19",
    "title": "Dodawanie użytkowników"
  },
  "steps": [
    {
      "id": "s01",
      "narration": "Nowa osoba zaczyna pracę, a nie wiecie, od czego zacząć? Dzień dobry, jestem Maria z zespołu Sloneek i pokażę Wam, jak dodać użytkownika.",
      "actions": [
        {
          "type": "wait_ready",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_staff",
          "value": "15000"
        },
        {
          "type": "wait",
          "value": "800"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainNavigationDiv] a#navigation_company_staff",
        "url_contains": "/app/dashboard"
      },
      "part": 1,
      "part_title": "Wprowadzenie",
      "hold_after_ms": 400
    },
    {
      "id": "s02",
      "narration": "W lewym menu w sekcji Firma rozwijam Użytkownicy i otwieram Zarządzanie.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_staff",
          "before_ms": 1200
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_settings_users",
          "before_ms": 400
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=tableRow]",
          "value": "15000"
        }
      ],
      "expect": {
        "visible": "[data-cy=addUserButton]",
        "url_contains": "/app/settings/users"
      }
    },
    {
      "id": "s03",
      "narration": "Tutaj widzicie wszystkich aktywnych użytkowników z zespołem, stanowiskiem i rolami. Szukać możecie po imieniu, e-mailu, zespole, roli, stanowisku albo tagu.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] table thead",
          "before_ms": 400
        },
        {
          "type": "wait",
          "value": "1500"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] .p-datatable-header",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=tableRow]",
        "url_contains": "/app/settings/users"
      }
    },
    {
      "id": "s04",
      "narration": "Użytkowników dodacie ręcznie przyciskiem Dodaj, linkiem przez Zaproś albo importem z Google Workspace i Office 365.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=addUserButton]",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "900"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=inviteButton]",
          "before_ms": 200
        },
        {
          "type": "wait",
          "value": "900"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] button:has-text(\"Importuj użytkowników\")",
          "before_ms": 200
        }
      ],
      "expect": {
        "visible": "[data-cy=inviteButton]",
        "url_contains": "/app/settings/users"
      }
    },
    {
      "id": "s05",
      "narration": "Zaczniemy ręcznie. Klikam Dodaj i otwiera się formularz Utwórz nowego użytkownika.",
      "actions": [
        {
          "type": "hover",
          "selector": "[data-cy=addUserButton] button",
          "before_ms": 400
        },
        {
          "type": "click",
          "selector": "[data-cy=addUserButton] button",
          "before_ms": 400
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=usersCreateForm] [data-cy=firstNameInput]",
          "value": "15000"
        }
      ],
      "expect": {
        "visible": "[data-cy=usersCreateForm]",
        "url_contains": "/app/company-details/member/new"
      },
      "part": 2,
      "part_title": "Dane podstawowe"
    },
    {
      "id": "s06",
      "narration": "Najpierw status konta. Anna zaczyna pracę dopiero za kilka tygodni, dlatego wybieram Użytkownik nie jest aktywny.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=userInactiveRadio]",
          "before_ms": 1800
        }
      ],
      "expect": {
        "visible": "[data-cy=hirePacketSelect]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s07",
      "narration": "Nieaktywny użytkownik nie może się zalogować, nie dostanie żadnego e-maila i nie płacicie za niego licencji. To idealny stan na przygotowanie startu.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=usersCreateForm] .user-activation-box .text-hint",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=usersCreateForm] .user-activation-box .text-hint",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s08",
      "narration": "Obowiązkowe są tylko imię, nazwisko i e-mail. Wpisuję Anna Kowalska.",
      "actions": [
        {
          "type": "type",
          "selector": "[data-cy=firstNameInput]",
          "value": "Anna",
          "clear": true,
          "before_ms": 600
        },
        {
          "type": "type",
          "selector": "[data-cy=surnameInput]",
          "value": "Kowalska",
          "clear": true,
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=surnameInput]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s09",
      "narration": "Podaję jej służbowy e-mail. Na ten adres po aktywacji przyjdzie zaproszenie do aplikacji Sloneek.",
      "actions": [
        {
          "type": "type",
          "selector": "[data-cy=emailInput]",
          "value": "anna.kowalska@example.com",
          "clear": true,
          "before_ms": 400,
          "speed": "fast"
        }
      ],
      "expect": {
        "visible": "[data-cy=emailInput]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s10",
      "narration": "Opcja Ukryj adres e-mail dla innych współpracowników schowa adres w sekcji Współpracownicy. Przyda się na przykład przy prywatnym e-mailu.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=usersCreateForm] nb-checkbox:has-text(\"Ukryj adres e-mail dla innych współpracowników\")",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=usersCreateForm] nb-checkbox",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s11",
      "narration": "Specjalne uprawnienia użytkownika dodają role ponad zwykłego użytkownika. Rozwijam listę, ale niczego nie wybieram.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=userRolesSelect] button",
          "before_ms": 1200
        },
        {
          "type": "wait_ready",
          "selector": "nb-option[data-cy=userRole-admin]",
          "value": "5000"
        },
        {
          "type": "highlight",
          "selector": "nb-option-list",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "nb-option[data-cy=userRole-ombudsman]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s12",
      "narration": "Administrator zarządza całą aplikacją i widzi wszystkie dane. Menedżer dokumentów albo Menedżer aktywów ma pełny dostęp tylko do swojego modułu.",
      "actions": [
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-admin]",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "2200"
        },
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-document_manager]",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "1200"
        },
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-property_administrator]",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "nb-option[data-cy=userRole-admin]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s13",
      "narration": "Menedżer raportów ma dostęp do wszystkich raportów, a Rzecznik Praw Obywatelskich jako jedyny czyta Skrzynkę zaufania. Zwykły pracownik nic z tego nie potrzebuje.",
      "actions": [
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-reporting]",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "2000"
        },
        {
          "type": "hover",
          "selector": "nb-option[data-cy=userRole-ombudsman]",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "1800"
        },
        {
          "type": "press",
          "value": "Escape",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "500"
        }
      ],
      "expect": {
        "visible": "[data-cy=userRolesSelect] button:has-text(\"Specjalne uprawnienia użytkownika\")",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s14",
      "narration": "Rodzaj stosunku pracy ustawiam na Pracownik. Do wyboru jest też wykonawca, wolny zawód albo staż.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=employmentTypesSelect] button",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "hover",
          "selector": "nb-option[data-cy=employmentType-contractor]",
          "before_ms": 300
        },
        {
          "type": "click",
          "selector": "nb-option[data-cy=employmentType-employee]",
          "before_ms": 900
        }
      ],
      "expect": {
        "visible": "[data-cy=employmentTypesSelect] button:has-text(\"Pracownik\")",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s15",
      "narration": "Po prawej są pozostałe dane dotyczące pracy. W polu Data rozpoczęcia pracy w firmie wpisuję jej pierwszy dzień pracy.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=joinDateInput]",
          "before_ms": 1000
        },
        {
          "type": "type",
          "selector": "[data-cy=joinDateInput]",
          "value": "{{DATE:+21d:DD.MM.YYYY}}",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "600"
        },
        {
          "type": "click",
          "selector": "nb-calendar nb-calendar-day-cell.selected",
          "before_ms": 400
        }
      ],
      "expect": {
        "visible": "[data-cy=joinDateInput]",
        "url_contains": "/member/new"
      },
      "part": 3,
      "part_title": "Dane dotyczące pracy"
    },
    {
      "id": "s16",
      "narration": "Data rozpoczęcia zapisze się w historii karty. Proporcjonalnej części urlopu Sloneek jednak sam nie wylicza, ustawicie ją w nieobecnościach użytkownika.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=joinDateInput]",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=joinDateInput]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s17",
      "narration": "Stanowisko wybieram z listy, tutaj Specjalista ds. obsługi klienta. Nowe stanowiska dodacie przez link Ustawienia pozycji.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=positionSelect] button",
          "before_ms": 500
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "click",
          "selector": "nb-option[data-cy=\"positionOption-Specjalista ds. obsługi klienta\"]",
          "before_ms": 500
        },
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] a:has-text(\"Ustawienia pozycji\")",
          "before_ms": 500
        }
      ],
      "expect": {
        "visible": "[data-cy=positionSelect] button:has-text(\"Specjalista ds. obsługi klienta\")",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s18",
      "narration": "Annę przypisuję do zespołu Obsługa klienta. Zespół określa jej menedżera i to, kto zatwierdza jej nieobecności i czas pracy.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=teamsSelect] button",
          "before_ms": 500
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "click",
          "selector": "nb-option[data-cy=\"team-Obsługa klienta\"]",
          "before_ms": 500
        }
      ],
      "expect": {
        "visible": "[data-cy=teamsSelect] button:has-text(\"Obsługa klienta\")",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s19",
      "narration": "I jeszcze miejsce pracy, tutaj Praha. Pozostałe dane możecie uzupełnić w dowolnym momencie później.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=workLocationSelect] button",
          "before_ms": 500
        },
        {
          "type": "wait",
          "value": "700"
        },
        {
          "type": "click",
          "selector": "nb-option[data-cy=workLocation-Praha]",
          "before_ms": 500
        }
      ],
      "expect": {
        "visible": "[data-cy=workLocationSelect] button:has-text(\"Praha\")",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s20",
      "narration": "Gotowe, klikam Stwórz użytkownika. Sloneek od razu zapyta, czy chcę przypisać typ współpracy.",
      "actions": [
        {
          "type": "hover",
          "selector": "[data-cy=usersCreateForm] [data-cy=submitButton]",
          "before_ms": 500
        },
        {
          "type": "click",
          "selector": "[data-cy=usersCreateForm] [data-cy=submitButton]",
          "before_ms": 500
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=confirmationDialog]:has-text(\"Przypisać typ współpracy?\")",
          "value": "15000"
        }
      ],
      "expect": {
        "visible": "[data-cy=confirmationDialog] [data-cy=submitButton]",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s21",
      "narration": "Typ współpracy to wymiar etatu, według którego liczy się czas pracy i salda nieobecności. Wybieram Tak.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=confirmationDialog] [data-cy=submitButton]",
          "before_ms": 2500
        },
        {
          "type": "wait_ready",
          "selector": "nb-dialog-container:has-text(\"Wybór rodzaju współpracy\")",
          "value": "10000"
        }
      ],
      "expect": {
        "visible": "nb-dialog-container slnk-common-autocomplete",
        "url_contains": "/member/new"
      }
    },
    {
      "id": "s22",
      "narration": "Wybieram Pełny etat 40 godzin. Ważność zaczyna się od dnia rozpoczęcia pracy, zaznaczam Czas nieokreślony i zapisuję.",
      "actions": [
        {
          "type": "click",
          "selector": "nb-dialog-container slnk-common-autocomplete",
          "before_ms": 500
        },
        {
          "type": "wait",
          "value": "800"
        },
        {
          "type": "click",
          "selector": "slnk-common-autocomplete-option:has-text(\"Pełny etat 40 h\")",
          "before_ms": 400
        },
        {
          "type": "wait",
          "value": "500"
        },
        {
          "type": "click",
          "selector": "nb-dialog-container nb-checkbox label",
          "before_ms": 600
        },
        {
          "type": "click",
          "selector": "nb-dialog-container button:has-text(\"Zapisz\")",
          "before_ms": 600
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=mainContentCenterDiv] a[href$=\"/contracts-and-terms\"]",
          "value": "15000"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainContentCenterDiv] a[href$=\"/work-data\"]",
        "url_contains": "/work-data"
      }
    },
    {
      "id": "s23",
      "narration": "Anna ma teraz własną kartę użytkownika. W nagłówku widzicie, że na razie jest nieaktywna.",
      "actions": [
        {
          "type": "wait_ready",
          "selector": "slnk-common-header-autocomplete .text-danger:text-is(\"(Nieaktywny)\")",
          "value": "10000"
        },
        {
          "type": "highlight",
          "selector": "slnk-common-header-autocomplete .selected-item-container",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "slnk-common-header-autocomplete .text-danger:text-is(\"(Nieaktywny)\")",
        "url_contains": "/work-data"
      },
      "part": 4,
      "part_title": "Karta użytkownika",
      "voice_after_actions": 1
    },
    {
      "id": "s24",
      "narration": "W zakładkach znajdziecie dane osobowe, etat i warunki finansowe, nieobecności, dokumenty, narzędzia pracy i historię zmian.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] ul.route-tabset",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=mainContentCenterDiv] a[href$=\"/history\"]",
        "url_contains": "/work-data"
      }
    },
    {
      "id": "s25",
      "narration": "W zakładce Rodzaj współpracy i warunki finansowe jest jej pełny etat. Możecie tu też dodać warunki finansowe.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainContentCenterDiv] a[href$=\"/contracts-and-terms\"]",
          "before_ms": 400
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=companyMemberContractsAndTerms] [data-cy=tableRow]:has-text(\"Pełny etat 40 h\")",
          "value": "15000"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=companyMemberContractsAndTerms] [data-cy=tableRow]:has-text(\"Pełny etat 40 h\")",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "1200"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=companyMemberContractsAndTerms] button:has-text(\"Dodaj warunki finansowe\")",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=companyMemberContractsAndTerms] [data-cy=tableRow]:has-text(\"Czas nieokreślony\")",
        "url_contains": "/contracts-and-terms"
      },
      "voice_after_actions": 2
    },
    {
      "id": "s26",
      "narration": "Menedżera i osoby zatwierdzające ustawicie w sekcji Zespoły. Gdy zespół nie ma menedżera, wnioski zatwierdzają administratorzy.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainContentCenterDiv] a[href$=\"/work-data\"]",
          "before_ms": 400
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=teamsSelect]",
          "value": "15000"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=teamsSelect]",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "[data-cy=teamsSelect] button:has-text(\"Obsługa klienta\")",
        "url_contains": "/work-data"
      },
      "voice_after_actions": 2
    },
    {
      "id": "s27",
      "narration": "Zanim aktywujecie Annę, ustawcie jej język. W zakładce Powiadomienia i integracje wybieram Polish, czyli polski, i zapisuję.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainContentCenterDiv] a[href$=\"/interface-settings\"]",
          "before_ms": 1200
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=companyMemberInterfaceSettings] nb-select",
          "value": "15000"
        },
        {
          "type": "click",
          "selector": "[data-cy=companyMemberInterfaceSettings] nb-select button",
          "before_ms": 500
        },
        {
          "type": "wait",
          "value": "600"
        },
        {
          "type": "click",
          "selector": "nb-option:text-is(\"Polish\")",
          "before_ms": 500
        },
        {
          "type": "click",
          "selector": "[data-cy=companyMemberInterfaceSettingsSaveButton]",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "1200"
        }
      ],
      "expect": {
        "visible": "[data-cy=companyMemberInterfaceSettings] nb-select button:has-text(\"Polish\")",
        "url_contains": "/interface-settings"
      },
      "part": 5,
      "part_title": "Aktywacja"
    },
    {
      "id": "s28",
      "narration": "Zaproszenie i aplikacja będą wtedy po polsku. Gdy Anna zacznie pracę, otwórzcie Akcje i wybierzcie Aktywuj.",
      "actions": [
        {
          "type": "click",
          "selector": "[data-cy=mainContentCenterDiv] button:has-text(\"Akcje\")",
          "before_ms": 1500
        },
