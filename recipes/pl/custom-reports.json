  "_explored": {
    "date": "2026-10-08",
    "by": "Claude přes BrowserOS neo, admin Thomas Claver, UI cs",
    "notes": "v2: krátké kroky jako u absence (jedna věta = jedna akce), hlas Jana. Selektory ověřeny resolverem (count 1 / visible 1) a celý tok proklikán. Tlačítko se jmenuje 'Vytvořit nový report' (ne 'Vytvořit vlastní report' z help centra), záložky: Všechny reporty / Oblíbené / Vytvořeno mnou / Veřejný / Předpřipravené. Pohledy u absencí: Detailní / Shrnutí / Typy / Dny (zbývající fond). Export: Exportovat jako CSV / Exportovat jako Excel (.xlsx). Možnosti: Upravit název nebo popis / Přidat k oblíbeným / Smazat report. Odkaz presetu je v tabulce zalomený na dva řádky a rekordér kliká do středu bounding boxu (míjí) – proto hover + navigate na /app/custom-reports/579. Uložení reportu trvá na pre-produ 5–8 s. Před opakovaným natáčením smazat report 'Čerpání dovolené – přehled' (koš v seznamu nebo Možnosti → Smazat report)."
  },
  "steps": [
    {
      "id": "s01",
      "part": 1,
      "part_title": "Wprowadzenie",
      "narration": "Ile urlopu zostało pracownikom, kto ma nadgodziny i co wysłać do księgowej? Dzień dobry, jestem Maria z zespołu Sloneek i dziś pokażę Wam raporty niestandardowe.",
      "actions": [
        {
          "type": "wait",
          "value": "1500"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainNavigationDiv] a[href=\"/app/custom-reports\"]",
        "url_contains": "/app/dashboard"
      },
      "hold_after_ms": 400
    },
    {
      "id": "s02",
      "narration": "Raporty znajdziecie w lewym menu na samym dole, pod pozycją Raporty niestandardowe.",
      "actions": [
        {
          "type": "hover",
          "selector": "[data-cy=mainNavigationDiv] a[href=\"/app/custom-reports\"]",
          "before_ms": 600
        },
        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a[href=\"/app/custom-reports\"]",
          "before_ms": 900
        },
        {
          "type": "wait",
          "value": "2500"
        }
      ],
      "expect": {
        "visible": "h1:text-is(\"Raporty niestandardowe\")",
        "url_contains": "/app/custom-reports"
      }
    },
    {
      "id": "s03",
      "narration": "U góry są zakładki: wszystkie raporty, ulubione, stworzone przeze mnie, publiczne i gotowe. Gotowe raporty wystarczy otworzyć i ewentualnie dostosować.",
      "actions": [
        {
          "type": "highlight",
          "selector": ".p-tablist-tab-list",
          "before_ms": 600
        },
        {
          "type": "wait",
          "value": "3500"
        },
        {
          "type": "highlight",
          "selector": "p-tab:text-is(\"Gotowe\")",
          "before_ms": 300
        }
      ],
      "expect": {
        "visible": "p-tab:text-is(\"Gotowe\")",
        "url_contains": "/app/custom-reports"
      }
    },
    {
      "id": "s04",
      "part": 2,
      "part_title": "Ustawienia",
      "narration": "Moduł nie wymaga żadnej konfiguracji. Otwieram Podsumowanie złożonych wynagrodzeń.",
      "actions": [
        {
          "type": "hover",
          "selector": "a[href=\"/app/custom-reports/579\"]",
          "before_ms": 1500
        },
        {
          "type": "wait",
          "value": "600"
        },
        {
          "type": "navigate",
          "value": "https://app-pre-production.sloneek.com/app/custom-reports/579"
        },
        {
          "type": "wait",
          "value": "3500"
        }
      ],
      "expect": {
        "visible": "h1:text-is(\"Podsumowanie złożonych wynagrodzeń\")",
        "url_contains": "/app/custom-reports/579"
      }
    },
    {
      "id": "s05",
      "narration": "U góry wybieram okres, po lewej kolumny, a po prawej od razu widzę dane.",
      "actions": [
        {
          "type": "highlight",
          "selector": "p-togglebutton:text-is(\"W zeszłym miesiącu\")",
          "before_ms": 300
        },
        {
          "type": "highlight",
          "selector": "[data-cy=\"crDetail.sidebarTab.include-data\"]",
          "before_ms": 900
        },
        {
          "type": "zoom",
          "selector": "th[data-cy=\"crDetail.grid.header.employee_name\"]",
          "value": "1.4",
          "hold_ms": 1500,
          "before_ms": 600
        }
      ],
      "expect": {
        "visible": "th[data-cy=\"crDetail.grid.header.employee_name\"]",
        "url_contains": "/app/custom-reports/579"
      }
    },
    {
      "id": "s06",
      "narration": "Raport korzysta z nieobecności, czasu pracy, aktywności i kart użytkowników, więc im staranniej je prowadzicie, tym lepszy macie przegląd.",
      "actions": [
