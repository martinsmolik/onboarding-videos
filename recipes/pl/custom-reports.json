    {
      "id": "s19",
      "part": 5,
      "part_title": "Podsumowanie",
      "narration": "I gotowe. Umiecie otworzyć gotowy raport, zbudować własny, przefiltrować go, zapisać i wyeksportować. Wskazówka na koniec: w zakładce Zaawansowany pogrupujecie i zsumujecie dane.",
      "actions": [
        {
          "type": "wait",
          "value": "1000"
        }
      ],
      "expect": {
        "visible": "h1:text-is(\"Raporty niestandardowe\")",
        "url_contains": "/app/custom-reports"
      }
