        {
          "type": "click",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_assets:text-is(\"Narzędzia\")",
          "before_ms": 300
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_assets_management",
          "value": "5000"
