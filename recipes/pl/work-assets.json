        {
          "type": "wait",
          "value": "400"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] th.cdk-column-inventory_number",
          "before_ms": 300
        },
        {
          "type": "highlight",
          "selector": "[data-cy=mainContentCenterDiv] th.cdk-column-categories",
          "before_ms": 200
