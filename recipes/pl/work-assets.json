      "narration": "Data nabycia wypełnia się dzisiejszą datą, a przy starszym narzędziu po prostu ją zmienicie.",
      "actions": [
        {
          "type": "highlight",
          "selector": "[data-cy=assetsForm] [data-cy=assetAcquisitionDateInput]",
