        {
          "type": "wait_ready",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_assets:text-is(\"Narzędzia\")",
          "value": "15000"
        },
        {
          "type": "wait",
          "value": "800"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainNavigationDiv] a#navigation_company_assets:text-is(\"Narzędzia\")",
        "url_contains": "/app/dashboard"
