          "before_ms": 500
        },
        {
          "type": "wait_ready",
          "selector": "[data-cy=adminPageDetailDialog] slnk-common-display-attachment img",
          "value": "10000"
        },
        {
          "type": "highlight",
          "selector": "[data-cy=adminPageDetailDialog] slnk-common-display-attachment",
          "before_ms": 300
        }
      ],
      "expect": {
