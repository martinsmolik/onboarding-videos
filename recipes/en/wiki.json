          "type": "wait_ready",
          "selector": "[data-cy=mainNavigationDiv] a#navigation_company_wiki_pages",
          "value": "15000"
        },
        {
          "type": "wait",
          "value": "800"
        }
      ],
      "expect": {
        "visible": "[data-cy=mainNavigationDiv] a#navigation_company_wiki_pages",
        "url_contains": "/app/dashboard"
      },
      "part": 1,
      "part_title": "Introduction",
      "hold_after_ms": 400
    },
    {
