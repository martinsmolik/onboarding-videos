        },
        {
          "type": "highlight",
          "selector": ".p-popover",
          "before_ms": 300
        },
        {
          "type": "wait",
          "value": "600"
        },
        {
          "type": "click",
          "selector": "[data-cy=mainContentCenterDiv] [data-cy=adminPagesSettingsTable] button:has-text(\"Filters\")",
