      "narration": "You can turn a weaker area straight into a personal goal. The shared notes hold the agreed action plan, which the employee sees too.",
      "actions": [
        {
          "type": "highlight",
          "selector": "button:has-text(\"Create personal goal\")",
          "before_ms": 400
        },
        {
