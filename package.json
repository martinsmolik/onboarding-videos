{
  "name": "sloneek-video-pipeline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node scripts/serve-demo.mjs",
    "record": "pnpm --filter @svp/recorder start",
    "assemble": "pnpm --filter @svp/assembler start",
    "pipeline": "pnpm --filter @svp/orchestrator start",
    "video": "EXPLORER_DRIVER=session SVP_TIMEOUT_EXPLORE_MS=${SVP_TIMEOUT_EXPLORE_MS:-14400000} pnpm --filter @svp/orchestrator start",
    "setup": "bash scripts/setup.sh",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test-all.mjs",
    "smoke": "node scripts/smoke.mjs",
    "local": "node scripts/local-run.mjs",
    "local:check": "node scripts/local-run.mjs --check",
    "voice:manifest": "node scripts/voice-manifest.mjs",
    "batch": "node packages/orchestrator/scripts/batch.mjs",
    "voice:fetch": "node scripts/fetch-voice.mjs",
    "pilot": "node scripts/fetch-voice.mjs add-users && node scripts/local-run.mjs recipes/add-users.en.json --id add-users --cdp auto --provider external",
    "absence": "node scripts/fetch-voice.mjs absence-cs && node scripts/local-run.mjs recipes/cs/absence.json --id absence-cs --cdp auto --provider external",
    "absence:record": "node scripts/local-run.mjs recipes/cs/absence.json --id absence-cs --cdp auto --provider external",
    "absence:mux": "node scripts/local-run.mjs recipes/cs/absence.json --id absence-cs --provider external --mux-only",
    "pilot:mux": "node scripts/local-run.mjs recipes/add-users.en.json --id add-users --provider external --mux-only"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
